# ============================================
# ENEM Lead Quiz - Environment Configuration
# ============================================
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=<troque_para_senha_segura>
POSTGRES_DB=quiz_db

# --------------------------------------------
# Backend (NestJS)
# --------------------------------------------
# URL de conexão com o banco (usada pelo Prisma)
# Em docker compose, o host é 'db'. Em produção externa, ajuste o host.
DATABASE_URL=postgresql://quiz_user:<troque_para_senha_segura>@db:5432/quiz_db

# Chave secreta para assinatura de JWT
# Gere uma com: openssl rand -base64 32
JWT_SECRET=<gere_com_openssl_rand_base64_32>

# Porta do servidor backend
PORT=3000

# Ambiente de execução (development | production)
NODE_ENV=production

# Rate limiting (THROTTLE_TTL em segundos, THROTTLE_LIMIT em requisições)
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --------------------------------------------
# Frontend (Vite + React)
# --------------------------------------------
# URL base da API backend
# Em docker compose local: http://localhost:3000
# Em produção com domínio: https://api.seudominio.com
VITE_API_URL=http://localhost:3000
